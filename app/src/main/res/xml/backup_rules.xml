<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9-11. Same policy as data_extraction_rules.xml: nothing goes to Google's cloud
    backup. Files are only included for a direct phone-to-phone transfer, never the encrypted
    API key. Users back up to a file of their choosing in Settings > Backup & restore.
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
    <exclude domain="sharedpref" path="hangry_secure_prefs.xml" />
</full-backup-content>
