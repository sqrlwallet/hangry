<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility for the Health Connect provider app, required on Android 11-13
         where Health Connect is a separate installed app (built into Settings on Android 14+),
         and for resolving the system camera app used by the AI photo-capture features. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Voice input for Ask Dash via the system speech recogniser. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- Required only for the opt-in AI features (Settings > AI Features): calling OpenRouter
         directly from the device with the user's own key, and writing AI-estimated nutrition
         entries back to Health Connect. No permission here is used unless AI features are
         explicitly enabled. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />

    <!-- Breathing exercises: log completed sessions to Health Connect (Mindfulness where
         supported, otherwise a Guided Breathing exercise session), and keep the session's
         audio cues running with the screen off via a media-playback foreground service. -->
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Shows the ongoing breathing-session notification (with its End button) on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Let Hangry always run in background?" - asked in onboarding and Settings, never assumed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Supplement reminders: on-time alarms where Android allows them (otherwise they arrive
         within a few minutes), re-armed after a reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Comprehensive Health Connect Permissions -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />

    <!-- Health records (read-only): home glucose readings, period tracking (shown only when sex
         is set to female), and Health Connect medical records on devices that support them. -->
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.READ_MEDICAL_DATA_LABORATORY_RESULTS" />
    <uses-permission android:name="android.permission.health.READ_MEDICAL_DATA_VITAL_SIGNS" />
    <uses-permission android:name="android.permission.health.READ_MEDICAL_DATA_CONDITIONS" />
    <uses-permission android:name="android.permission.health.READ_MEDICAL_DATA_ALLERGIES_INTOLERANCES" />
    <uses-permission android:name="android.permission.health.READ_MEDICAL_DATA_PREGNANCY" />

    <application
        android:name=".HangryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hangry">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hangry"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect Permissions Rationale for Android 13 backwards compatibility -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect Privacy Policy & Permission Usage for Android 14+ Framework Integration -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Hands a temp file Uri to the system camera app for food/posture photo capture. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kevan.hangry.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".data.breathing.BreathingSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".data.supplements.SupplementReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Bedtime nudge: fires the reminder and re-plans it after reboot, updates and clock changes. -->
        <receiver
            android:name=".data.nudges.BedtimeReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home Screen AppWidgets -->
        <receiver
            android:name=".ui.widget.ActivityWidgetProvider"
            android:exported="true"
            android:label="Hangry Activity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_activity" />
        </receiver>

        <receiver
            android:name=".ui.widget.QuickLogWidgetProvider"
            android:exported="true"
            android:label="Hangry Log Meal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_quick_log" />
        </receiver>

        <receiver
            android:name=".ui.widget.SleepWidgetProvider"
            android:exported="true"
            android:label="Hangry Sleep">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_sleep" />
        </receiver>

        <receiver
            android:name=".ui.widget.RecoveryWidgetProvider"
            android:exported="true"
            android:label="Hangry Recovery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_recovery" />
        </receiver>

        <receiver
            android:name=".ui.widget.SupplementsWidgetProvider"
            android:exported="true"
            android:label="Hangry Supplements">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_supplements" />
        </receiver>

        <receiver
            android:name=".ui.widget.OverviewWidgetProvider"
            android:exported="true"
            android:label="Hangry Overview">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_overview" />
        </receiver>

        <receiver
            android:name=".ui.widget.BreatheWidgetProvider"
            android:exported="true"
            android:label="Hangry Breathe">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_breathe" />
        </receiver>

        <receiver
            android:name=".ui.widget.HeartWidgetProvider"
            android:exported="true"
            android:label="Hangry Heart">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_heart" />
        </receiver>

        <receiver
            android:name=".ui.widget.HealthMarkersWidgetProvider"
            android:exported="true"
            android:label="Hangry Health Markers">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_markers" />
        </receiver>

        <receiver
            android:name=".ui.widget.GoalsWidgetProvider"
            android:exported="true"
            android:label="Hangry Goals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_goals" />
        </receiver>

        <receiver
            android:name=".ui.widget.WeightWidgetProvider"
            android:exported="true"
            android:label="Hangry Weight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_weight" />
        </receiver>

        <receiver
            android:name=".ui.widget.PostureWidgetProvider"
            android:exported="true"
            android:label="Hangry Posture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_posture" />
        </receiver>

        <receiver
            android:name=".ui.widget.CycleWidgetProvider"
            android:exported="true"
            android:label="Hangry Cycle">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_cycle" />
        </receiver>

        <receiver
            android:name=".ui.widget.CaloriesWidgetProvider"
            android:exported="true"
            android:label="Hangry Calories">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_calories" />
        </receiver>

        <receiver
            android:name=".ui.widget.NutritionWidgetProvider"
            android:exported="true"
            android:label="Hangry Nutrition">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_nutrition" />
        </receiver>

        <!-- Quick-add buttons on the Nutrition widget log a food without opening the app. -->
        <receiver
            android:name=".ui.widget.NutritionWidgetReceiver"
            android:exported="false" />
    </application>

</manifest>