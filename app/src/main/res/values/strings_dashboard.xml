    <string name="dashboard_widget_how_to_add_body">1. Press and hold any empty area on your phone\'s home screen.\n2. Tap \'Widgets\' in the pop-up menu.\n3. Scroll down and locate \'Hangry\'.\n4. Touch and drag your preferred widget onto your screen.</string>
    <string name="dashboard_widget_back">Back</string>
    <string name="dashboard_widget_screen_title">Home Screen Widgets</string>
    <string name="dashboard_widget_intro_title">Glanceable Health on Your Phone</string>
    <string name="dashboard_widget_intro_body">Add widgets to your Android home screen for activity, calories, nutrition, sleep, recovery, heart, health markers, goals, weight, posture, cycle, breathing, supplements, fasting and one-tap meal logging.</string>
    <string name="dashboard_widget_activity_title">Daily Activity</string>
    <string name="dashboard_widget_activity_desc">Today\'s steps and active calories.</string>
    <string name="dashboard_widget_quick_log_title">Quick Log Meal</string>
    <string name="dashboard_widget_quick_log_desc">One-tap camera shortcut to snap and log meals in seconds.</string>
    <string name="dashboard_widget_calories_title">Calories</string>
    <string name="dashboard_widget_calories_desc">Calories eaten today as a ring against your daily target, with how much is left.</string>
    <string name="dashboard_widget_nutrition_title">Nutrition</string>
    <string name="dashboard_widget_nutrition_desc">Calories, protein, carbs and fat today. The buttons log your most recent saved meals in one tap, without opening the app.</string>
    <string name="dashboard_widget_sleep_title">Sleep Insights</string>
    <string name="dashboard_widget_sleep_desc">Last night\'s sleep score out of 100, how long you slept, and when.</string>
    <string name="dashboard_widget_recovery_title">Recovery Score</string>
    <string name="dashboard_widget_recovery_desc">Autonomic recovery percentage, readiness band, and advice.</string>
    <string name="dashboard_widget_supplements_title">Supplements</string>
    <string name="dashboard_widget_supplements_desc">Your next supplement dose and how many you\'ve taken today.</string>
    <string name="dashboard_widget_overview_title">Daily Overview</string>
    <string name="dashboard_widget_overview_desc">All-in-one glance: Recovery, Activity, Sleep, and Quick Log.</string>
    <string name="dashboard_widget_fasting_title">Fasting</string>
    <string name="dashboard_widget_fasting_desc">A live fasting timer with your stage and streak, and a button to start or end a fast. Turn fasting on in More › Fasting first.</string>
    <string name="dashboard_widget_breathe_title">Breathe</string>
    <string name="dashboard_widget_breathe_desc">Minutes breathed today and this week. Tap to start your usual pattern with Dash, or pick another.</string>
    <string name="dashboard_widget_heart_title">Heart</string>
    <string name="dashboard_widget_heart_desc">Resting heart rate and HRV, each compared with your 4-week normal.</string>
    <string name="dashboard_widget_markers_title">Health Markers</string>
    <string name="dashboard_widget_markers_desc">Latest blood pressure and blood sugar with their status. The + opens Health Records to log a reading.</string>
    <string name="dashboard_widget_goals_title">Goals</string>
    <string name="dashboard_widget_goals_desc">Progress toward your weight goal and any health marker goals, up to three at a time.</string>
    <string name="dashboard_widget_weight_title">Weight Trend</string>
    <string name="dashboard_widget_weight_desc">Latest weight, how much it changed in 30 days, and a trend line.</string>
    <string name="dashboard_widget_posture_title">Posture Check</string>
    <string name="dashboard_widget_posture_desc">Your last posture score and when you took it, with a button that opens a new check.</string>
    <string name="dashboard_widget_cycle_title">Cycle</string>
    <string name="dashboard_widget_cycle_desc">Cycle day and when your next period is predicted. Available when your sex is set to female.</string>
