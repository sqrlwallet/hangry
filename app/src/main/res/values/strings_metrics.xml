    <string name="metrics_sleep_tonights_need">Tonight\'s Sleep Need</string>
    <string name="metrics_sleep_tonights_need_coach_body">Your sleep goal, plus a slice of any sleep debt so it\'s paid back over two weeks (debt from the last 14 nights ÷ 14, at most an hour), plus up to 30 minutes after a harder-than-usual day.</string>
    <string name="metrics_sleep_score_title">Sleep Score</string>
    <string name="metrics_sleep_score_parts_body">Half is how much of your need you got. The rest is how well you slept: time asleep vs time in bed, deep and REM sleep against healthy ranges, and how regular your bed and wake times are.</string>
