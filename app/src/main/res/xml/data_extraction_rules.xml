<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Hangry's health data never goes to Google's cloud backup: everything the app
    stores is excluded there. Users back up deliberately instead, to a file they choose
    (Settings > Backup & restore - see HangryBackupManager).

    A direct phone-to-phone transfer (cable or local Wi-Fi when setting up a new phone) never
    touches the cloud, so it still carries the data across - except the encrypted API key,
    whose Keystore key can't leave the old phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hangry_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
